  "ladder": {
    "title": "The Six Levels",
    "levels": [
      {
        "code": "A1",
        "name": "Breakthrough",
        "group": "basic",
        "canDo": "Introduce yourself and answer simple questions.",
        "hours": "90–100"
      },
      {
        "code": "A2",
        "name": "Waystage",
        "group": "basic",
        "canDo": "Handle routine talk: shopping, work, family.",
        "hours": "180–200"
      },
      {
        "code": "B1",
        "name": "Threshold",
        "group": "independent",
        "canDo": "Get by while traveling; share plans and opinions.",
        "hours": "350–400"
      },
      {
        "code": "B2",
        "name": "Vantage",
        "group": "independent",
        "canDo": "Follow complex ideas; talk easily with native speakers.",
        "hours": "500–600"
      },
      {
        "code": "C1",
        "name": "Operational Proficiency",
        "group": "proficient",
        "canDo": "Read demanding texts; speak fluently without searching for words.",
        "hours": "700–800"
      },
      {
        "code": "C2",
        "name": "Mastery",
        "group": "proficient",
        "canDo": "Understand nearly everything; express fine nuance.",
        "hours": "1,000–1,200"
      }
    ],
